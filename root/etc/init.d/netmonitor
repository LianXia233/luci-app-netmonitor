#!/bin/sh /etc/rc.common
#
# luci-app-netmonitor 服务控制脚本
#
# 支持：
#   /etc/init.d/netmonitor start|stop|restart|reload|enable|disable|status
#
# 说明：
#   * 使用 procd 管理，异常退出自动 respawn
#   * 通过 procd 的 file trigger 监听 /etc/config/netmonitor，
#     配置变更后自动触发 reload（SIGHUP 通知守护进程重载配置）
#   * 守护进程为单一实例，浏览器页面只读取状态，不会创建重复的探测任务
#

START=95
STOP=10

USE_PROCD=1

PROG=/usr/libexec/netmonitor/netmon-daemon.sh
PIDFILE=/var/run/netmonitor.pid

start_service() {
	local enabled

	config_load netmonitor
	config_get_bool enabled global enabled 0

	if [ "$enabled" != "1" ]; then
		logger -t netmonitor "service is disabled in UCI (set netmonitor.global.enabled=1 to start it)"
		return 1
	fi

	mkdir -p /tmp/netmonitor/ring /tmp/netmonitor/hist /tmp/netmonitor/state
	# 不要在这里清理临时目录：守护进程按 pid 独占 tmp.<pid>，而 restart 时
	# 旧实例可能仍在收尾（procd term_timeout 5s），清掉会让它写出空结果。
	# 遗留目录由守护进程启动时按「pid 已不存在」自行回收。

	procd_open_instance netmonitor
	procd_set_param command /bin/sh "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param file /etc/config/netmonitor
	procd_set_param pidfile "$PIDFILE"
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance

	logger -t netmonitor "service started"
}

stop_service() {
	# procd 会负责杀掉实例，这里仅清理运行期残留
	rm -f "$PIDFILE"
	# 临时目录交由守护进程按 pid 自行回收（见 start_service 里的说明）
	logger -t netmonitor "service stopped"
}

reload_service() {
	local pid
	pid=$(cat "$PIDFILE" 2>/dev/null)

	if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
		kill -HUP "$pid" 2>/dev/null
		logger -t netmonitor "configuration reload requested"
	else
		restart
	fi
}

service_triggers() {
	# 配置文件变化时触发 reload_service
	procd_add_reload_trigger netmonitor
}
